# Reolink NVR Configuration
REOLINK_IP=192.168.2.112
REOLINK_USERNAME=admin
REOLINK_PASSWORD=your_password_here
REOLINK_RTSP_PORT=554
# Reolink's native protocol ("media port") on the NVR; the 4K view uses it
REOLINK_MEDIA_PORT=9000
# 4K view: cameras that may stream 4K at once. The RLN8-410-E NVR refuses a
# third 4K stream, so keep 2 unless your NVR allows more.
REOLINK_HD_MAX_STREAMS=2
# Stop a camera's 4K stream after this many seconds without viewers
REOLINK_HD_IDLE_SECONDS=20
# 4K decoder: auto (GPU if available) | software | d3d11va | cuda | vaapi | qsv
REOLINK_HD_DECODER=auto
# Backend port (the frontend dev server proxies to 5001 unless told otherwise)
# BACKEND_PORT=5001

# YOLO Detection Settings
YOLO_MODEL=yolo26n.pt
YOLO_CONFIDENCE=0.5
# auto = pick the fastest backend on this PC: NVIDIA GPU (CUDA) if present,
#        otherwise OpenVINO on Intel hardware if a startup benchmark shows it is
#        faster, otherwise PyTorch on the CPU. The result is cached per PC.
# Force one with: cpu | cuda (or cuda:1 / 1 for another NVIDIA GPU) | intel:gpu | intel:cpu | intel:npu
YOLO_DEVICE=auto
# Set to 1 to re-export the OpenVINO models and re-run the benchmark on the next start
YOLO_REBENCHMARK=0
# Tracker config file: surveillance_tracker.yaml (TrackTrack + Re-ID, default)
# or botsort_tracker.yaml (BoT-SORT + Re-ID, the previous default)
TRACKER_CONFIG=surveillance_tracker.yaml

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Optional: Hugging Face for AI Chat
HF_TOKEN=your_huggingface_token_here
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.1

# Database
DATABASE_URL=sqlite+aiosqlite:///./surveillance.db

